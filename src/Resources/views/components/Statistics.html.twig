{#
  Deprecated Twig component nowo_performance.Statistics (since 3.15, removed in 4.0; the dashboard page renders its KPI
  tiles itself): the statistics as UiKit KPI tiles (@NowoPerformanceBundle/Performance/_kpis.html.twig).
  Props: stats (PerformanceController::index() stats), enableAccessRecords, environment; template (ignored).
#}
{% set _d = 'NowoPerformanceBundle' %}
{% set _kpis = [
    {label: {key: 'statistics.total_routes', domain: _d}, value: (stats.total_routes ?? 0)|number_format},
    {label: {key: 'statistics.avg_request_time', domain: _d}, value: ((stats.avg_request_time ?? 0) * 1000)|number_format(2) ~ ' ms', hint: {key: 'ui.kpi.max', domain: _d, params: {'%value%': ((stats.max_request_time ?? 0) * 1000)|number_format(2) ~ ' ms'}}},
    {label: {key: 'statistics.avg_query_time', domain: _d}, value: ((stats.avg_query_time ?? 0) * 1000)|number_format(2) ~ ' ms', hint: {key: 'ui.kpi.max', domain: _d, params: {'%value%': ((stats.max_query_time ?? 0) * 1000)|number_format(2) ~ ' ms'}}},
    {label: {key: 'statistics.avg_queries', domain: _d}, value: (stats.avg_queries ?? 0)|number_format(1), hint: {key: 'ui.kpi.max', domain: _d, params: {'%value%': (stats.max_queries ?? 0)|number_format}}},
] %}
{% if enableAccessRecords|default(false) %}
    {% set _kpis = _kpis|merge([{label: {key: 'statistics.total_records', domain: _d}, value: (stats.total_records ?? 0)|number_format, hint: {key: 'statistics.view_records', domain: _d}, href: path('nowo_performance.access_records', {env: environment|default('dev')}), variant: 'info', linkTile: true}]) %}
{% endif %}
<div {{ attributes|default('') }}>
    {{ include('@NowoPerformanceBundle/Performance/_kpis.html.twig', {kpis: _kpis, bundle: 'NowoPerformanceBundle'}) }}
</div>
