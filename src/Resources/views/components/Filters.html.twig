{#
  Deprecated Twig component nowo_performance.Filters (since 3.15, removed in 4.0; the dashboard page renders its
  filters through the UiKit list scaffold): the PerformanceFiltersType form with the UiKit `filters` theme slots.
  Props: form (FormView); template (ignored).
#}
{% set _b = 'NowoPerformanceBundle' %}
<div {{ attributes|default('') }}>
    {{ form_start(form, {attr: {class: nowo_ui_class('filters', _b), role: 'search', 'data-nowo-ui-filters': ''}}) }}
        {% for _child in form %}{% if not _child.rendered %}{{ form_row(_child, {row_attr: {class: nowo_ui_class('filters_field', _b)}}) }}{% endif %}{% endfor %}
        <div class="{{ nowo_ui_class('filters_actions', _b) }}"><button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'filters.apply_filters'|trans({}, 'NowoPerformanceBundle') }}</button></div>
    {{ form_end(form) }}
</div>
