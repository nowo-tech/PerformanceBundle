{# REQ-UI-001: accept css_framework / ui_template / template; bootstrap5 ≡ bootstrap markup #}
{% set _perf_css = nowo_performance_css_framework|default(css_framework|default(ui_template|default(template|default('bootstrap5')))) %}
{% set _is_bootstrap = _perf_css != 'tailwind' and (ui_template|default(_perf_css)) != 'tailwind' %}
{% set _ui = _is_bootstrap ? 'bootstrap' : 'tailwind' %}
{# REQ-TWIG-005: chart selects from ChartFiltersType (read once: the component builds a new view per call). #}
{% set _filters = this.filtersForm %}
{% if _is_bootstrap %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Performance Trends</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        {{ form_start(_filters) }}
                            {{ form_label(_filters.metric, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(_filters.metric, {attr: {class: 'form-select form-select-sm', style: 'width: auto; display: inline-block;'}}) }}
                            {{ form_label(_filters.days, null, {label_attr: {class: 'form-label ms-3'}}) }}
                            {{ form_widget(_filters.days, {attr: {class: 'form-select form-select-sm', style: 'width: auto; display: inline-block;'}}) }}
                            {% for child in _filters %}
                                {% if not child.rendered %}
                                    {{ form_row(child) }}
                                {% endif %}
                            {% endfor %}
                        {{ form_end(_filters) }}
                    </div>
                    <canvas id="performanceChart" style="max-height: 400px;"></canvas>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Performance Trends</h3>
            </div>
            <div class="p-6">
                {{ form_start(_filters, {attr: _filters.vars.attr|merge({class: 'mb-4 flex items-center gap-4'})}) }}
                    <div>
                        {{ form_label(_filters.metric, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(_filters.metric, {attr: {class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
                    </div>
                    <div>
                        {{ form_label(_filters.days, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(_filters.days, {attr: {class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
                    </div>
                    {% for child in _filters %}
                        {% if not child.rendered %}
                            {{ form_row(child) }}
                        {% endif %}
                    {% endfor %}
                {{ form_end(_filters) }}
                <div class="relative" style="height: 400px;">
                    <canvas id="performanceChart"></canvas>
                </div>
            </div>
        </div>
    </div>
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof Chart === 'undefined') return;

    const env = '{{ environment }}';
    const routeName = '{{ currentRoute ?? '' }}';
    const chartDataUrl = '{{ chartDataUrl }}';
    let chart = null;

    function loadChartData(metric, days) {
        const url = new URL(chartDataUrl, window.location.origin);
        url.searchParams.set('env', env);
        url.searchParams.set('metric', metric);
        url.searchParams.set('days', days);
        if (routeName) {
            url.searchParams.set('route', routeName);
        }

        fetch(url)
            .then(response => response.json())
            .then(data => {
                if (chart) {
                    chart.destroy();
                }

                const canvas = document.getElementById('performanceChart');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                chart = new Chart(ctx, {
                    type: 'line',
                    data: data,
                    options: {
                        responsive: true,
                        maintainAspectRatio: {% if _is_bootstrap %}true{% else %}false{% endif %},
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            })
            .catch(error => {
                console.error('Error loading chart data:', error);
            });
    }

    // Initial load
    loadChartData('requestTime', 7);

    // Update on change
    const chartMetric = document.getElementById('chart-metric');
    const chartDays = document.getElementById('chart-days');
    if (chartMetric) {
        chartMetric.addEventListener('change', function() {
            loadChartData(this.value, document.getElementById('chart-days')?.value || '7');
        });
    }
    if (chartDays) {
        chartDays.addEventListener('change', function() {
            loadChartData(document.getElementById('chart-metric')?.value || 'requestTime', this.value);
        });
    }
});
</script>
