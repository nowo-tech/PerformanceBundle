{#
  Deprecated Twig component nowo_performance.Charts (since 3.15, removed in 4.0). The client-side Chart.js charts were
  removed (no CDN / inline script, REQ-UI-003): the dashboard page renders a server-side trend chart. This component
  now links to the chart data endpoint (JSON) of the environment / route.
  Props: environment, currentRoute, chartDataUrl; template (ignored).
#}
{% set _b = 'NowoPerformanceBundle' %}
<div {{ attributes|default('') }}>
    {% set _body %}
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'ui.components.charts_moved'|trans({}, 'NowoPerformanceBundle') }}</p>
            <a class="{{ nowo_ui_class('btn_link', _b) }}" href="{{ chartDataUrl }}?{{ {env: environment, route: currentRoute}|filter(v => v is not null and v != '')|url_encode }}">{{ 'api.chart_data'|trans({}, 'NowoPerformanceBundle') }}</a>
    {% endset %}
    {{ include('@NowoPerformanceBundle/Performance/_card.html.twig', {title: 'ui.trend.title'|trans({'%days%': 7}, 'NowoPerformanceBundle'), bundle: _b, body: _body}) }}
</div>
