{#
  Deprecated Twig component nowo_performance.RoutesTable (since 3.15, removed in 4.0; the dashboard page renders the
  routes through the UiKit list scaffold, with its row actions): a read-only routes table with the UiKit table slots.
  Props: routes (list<RouteDataWithAggregates>), thresholds; template, sortBy, order, enableRecordManagement,
  enableReviewSystem, reviewForms, deleteForms (ignored).
#}
{% set _b = 'NowoPerformanceBundle' %}
{% set _d = 'NowoPerformanceBundle' %}
{% set _t = thresholds|default({}) %}
<div {{ attributes|default('') }}>
    {% if routes is empty %}
        {{ include(nowo_ui_partial('empty', _b), {message: 'dashboard.no_routes_found'|trans({}, _d), bundle: _b}) }}
    {% else %}
        <div class="{{ nowo_ui_class('table_wrap', _b) }}">
            <table class="{{ nowo_ui_class('table', _b) }}">
                <thead class="{{ nowo_ui_class('table_head', _b) }}">
                    <tr class="{{ nowo_ui_class('table_head_row', _b) }}">
                        {% for _entry, _align in {'routes_table.route_name': 'start', 'routes_table.http_method': 'start', 'routes_table.access_count': 'end', 'routes_table.request_time': 'end', 'routes_table.total_queries': 'end', 'routes_table.memory_usage': 'end'} %}
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }} nowo-ui-cell--{{ _align }}">{{ _entry|trans({}, _d) }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for route in routes %}
                        <tr class="{{ nowo_ui_class('table_row', _b) }}">
                            <td class="{{ nowo_ui_class('table_cell', _b) }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ route.name ?? '—' }}</code></td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }}">{{ route.httpMethod ?? '—' }}</td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end">{{ route.accessCount|number_format }}</td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end">
                                {%- if route.requestTime is not null -%}
                                    <span class="{{ nowo_ui_class(route.requestTime > (_t.request_time.critical ?? 1.0) ? 'badge_danger' : (route.requestTime > (_t.request_time.warning ?? 0.5) ? 'badge_warning' : 'badge_success'), _b) }}">{{ (route.requestTime * 1000)|number_format(2) }} ms</span>
                                {%- else -%}—{%- endif -%}
                            </td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end">{{ route.totalQueries ?? '—' }}</td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end">{{ route.memoryUsage is not null ? (route.memoryUsage / 1048576)|number_format(2) ~ ' MB' : '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
