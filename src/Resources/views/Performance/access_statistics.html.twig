{#
  Access statistics (REQ-UI-003): UiKit dashboard scaffold. Variable: page (View\DashboardPage from
  PerformancePageFactory::accessStatistics(): header access_statistics.title with the area tabs and the actions View
  records / Export records CSV / Export records JSON / Delete records matching the filter (POST + CSRF FormView behind a
  Confirm, with record management); KPI tiles total accesses, period, busiest hour, average response time).
  Extra variables: filterForm (RecordFiltersType, GET), statistics_by_hour, statistics_by_day_of_week,
  statistics_by_month, heatmap_data, total_access_count, environment, start_date, end_date; 3.14 variables kept for
  web_ui.templates overrides: environments, available_routes, selected_route, selected_status_code, deleteByFilterForm
  (backs the header action: render it once).
  Data block filled: nowo_ui_dashboard_cards (by hour, heatmap, by day of week, by month, filters).
#}
{% extends '@NowoUiKit/page/dashboard.html.twig' %}
{% trans_default_domain 'NowoPerformanceBundle' %}

{% block nowo_ui_dashboard_cards %}
    {% set _b = page.bundle %}
    {% set _card = '@NowoPerformanceBundle/Performance/_card.html.twig' %}
    {% set _days = [] %}
    {% for _d in 0..6 %}{% set _days = _days|merge([('ui.weekday.' ~ _d)|trans]) %}{% endfor %}

    {% if total_access_count|default(0) == 0 %}
        {{ include(nowo_ui_partial('empty', _b), {message: 'access_statistics.no_data'|trans, bundle: _b}) }}
    {% else %}
        {% set _body %}
                {{ include('@NowoPerformanceBundle/Performance/_bar_chart.html.twig', {
                    labels: statistics_by_hour|map(r => '%02d'|format(r.hour)),
                    values: statistics_by_hour|map(r => r.count),
                    height: 200,
                    decimals: 0,
                    unit: ' ' ~ 'access_statistics.requests'|trans,
                    title: 'access_statistics.by_hour'|trans,
                }) }}
        {% endset %}
        {{ include(_card, {title: 'access_statistics.by_hour'|trans, bundle: _b, testid: 'performance-by-hour', body: _body}) }}

        {% set _body %}
                {{ include('@NowoPerformanceBundle/Performance/_heatmap.html.twig', {heatmap: heatmap_data, days: _days, title: 'access_statistics.heatmap'|trans}) }}
        {% endset %}
        {{ include(_card, {title: 'access_statistics.heatmap'|trans, bundle: _b, testid: 'performance-heatmap', body: _body}) }}

        {% for _group in [{rows: statistics_by_day_of_week, key: 'by_day_of_week'}, {rows: statistics_by_month, key: 'by_month'}] %}
            {% if _group.rows|default([])|filter(r => r.count > 0) is not empty %}
                {% set _items = [] %}
                {% for _row in _group.rows|filter(r => r.count > 0) %}
                    {% set _codes = [] %}
                    {% for _code, _count in _row.status_codes|filter((v, k) => k >= 400) %}{% set _codes = _codes|merge([_code ~ ': ' ~ _count]) %}{% endfor %}
                                        {% set _items = _items|merge([{
                        label: _group.key == 'by_month' ? ('ui.month.' ~ _row.month)|trans : (_days[_row.day_of_week] ?? _row.day_name),
                        value: 'ui.kpi.requests'|trans({'%count%': _row.count|number_format}) ~ ' · ' ~ (_row.avg_response_time * 1000)|number_format(2) ~ ' ms' ~ (_codes is not empty ? ' · ' ~ _codes|join(', ') : ''),
                        badge: null,
                        href: null,
                    }]) %}
                {% endfor %}
                {% set _body %}{{ include(nowo_ui_partial('detail_list', _b), {items: _items, bundle: _b}) }}{% endset %}
                {{ include(_card, {title: ('access_statistics.' ~ _group.key)|trans, bundle: _b, testid: 'performance-' ~ _group.key|replace({_: '-'}), body: _body}) }}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% set _body %}
            {{ form_start(filterForm, {attr: {class: nowo_ui_class('filters', _b), role: 'search'}}) }}
                {# REQ-TWIG-003: child loop (fields and the Filter button) #}
                {% for _child in filterForm %}{% if not _child.rendered %}{{ form_row(_child, 'submit' in _child.vars.block_prefixes ? {attr: _child.vars.attr|merge({class: nowo_ui_class('btn_primary', _b)})} : {}) }}{% endif %}{% endfor %}
            {{ form_end(filterForm) }}
    {% endset %}
    {{ include(_card, {title: 'access_statistics.filters'|trans, bundle: _b, testid: 'performance-access-filters', body: _body}) }}
{% endblock %}
