{#
  Routes (dashboard home, REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  PerformancePageFactory::index(): header dashboard.title / dashboard.subtitle with the area tabs and the actions
  Export CSV / Export JSON / Clear all records (POST + CSRF FormView behind a Confirm, with record management); filters
  = PerformanceFiltersType; columns name (+ HTTP method badge), status codes, accesses, request time, query time, queries, memory,
  last access, review; rows = list<RouteDataWithAggregates>; row actions View records / Review (dialog) / Delete
  (confirm); Pagination; EmptyState dashboard.no_routes_found).
  Extra variables: kpis (list<KpiTile>), trend ({labels, values}: average request time per day, ms), top_used_routes,
  top_consumed_routes, missingDependencies, reviewForms (route id => FormView, one dialog each), thresholds,
  dateTimeFormat, dateFormat, autoRefreshInterval, environment; 3.14 variables kept for web_ui.templates overrides:
  routes, stats, paginator, form, clearForm, deleteForms (the same FormViews back the page actions: render each once).
  Data blocks filled: nowo_ui_list_filters (notices + KPI tiles before the filters), nowo_ui_list_row (cells),
  nowo_ui_list_after (trend + top routes), nowo_ui_modals (review dialogs), nowo_ui_head (auto refresh).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoPerformanceBundle' %}

{% block nowo_ui_head %}
    {{ parent() }}
    {% if autoRefreshInterval|default(0) > 0 %}<meta http-equiv="refresh" content="{{ autoRefreshInterval }}">{% endif %}
{% endblock %}

{% block nowo_ui_list_filters %}
    {% set _b = page.bundle %}
    {% if missingDependencies|default([]) is not empty %}
        <div class="{{ nowo_ui_class('flash', _b) }} {{ nowo_ui_class('flash_info', _b) }}" role="status" data-testid="performance-missing-dependencies">
            <p><strong>{{ 'ui.dependencies.title'|trans }}</strong> {{ 'ui.dependencies.intro'|trans }}</p>
            <ul>
                {% for dep in missingDependencies %}
                    <li><strong>{{ dep.feature }}</strong>: {{ dep.message }} <code class="{{ nowo_ui_class('code', _b) }}">{{ dep.install_command }}</code></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    {% if autoRefreshInterval|default(0) > 0 %}
        <p class="{{ nowo_ui_class('muted', _b) }}" data-testid="performance-auto-refresh">{{ 'ui.auto_refresh'|trans({'%seconds%': autoRefreshInterval}) }}</p>
    {% endif %}
    {{ include('@NowoPerformanceBundle/Performance/_kpis.html.twig', {kpis: kpis|default([]), bundle: _b, attr: {'data-testid': 'performance-kpis'}}) }}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    {% set _muted = nowo_ui_class('table_cell_muted', _b) %}
    {% set _t = thresholds|default({}) %}
    {% set _dash = '—' %}
    <td class="{{ _cell }}" data-label="{{ 'routes_table.route_name'|trans }}" data-required="1">
        <code class="{{ nowo_ui_class('code', _b) }}">{{ row.name ?? _dash }}</code>
        {%- if row.httpMethod %} <span class="{{ nowo_ui_class(row.httpMethod == 'DELETE' ? 'badge_danger' : (row.httpMethod in ['POST', 'PUT', 'PATCH'] ? 'badge_warning' : 'badge_neutral'), _b) }}" title="{{ 'routes_table.http_method'|trans }}">{{ row.httpMethod }}</span>{% endif -%}
    </td>
    {% if page.columns|filter(c => c.key == 'statusCodes') is not empty %}
        <td class="{{ _cell }}" data-label="{{ 'routes_table.status_codes'|trans }}" data-nowo-ui-priority="3">
            {%- set _total = row.totalResponses -%}
            {%- if row.statusCodes is not empty and _total > 0 -%}
                {%- for _code, _count in row.statusCodes|sort((a, b) => b <=> a) -%}
                    {%- set _variant = _code >= 500 ? 'badge_danger' : (_code >= 400 ? 'badge_warning' : (_code >= 300 ? 'badge_info' : 'badge_success')) -%}
                    <span class="{{ nowo_ui_class(_variant, _b) }}" title="{{ _count }} / {{ _total }}">{{ _code }} · {{ (_count / _total * 100)|number_format(1) }}%</span>{{ ' ' }}
                {%- endfor -%}
            {%- else -%}<span class="{{ _muted }}">{{ _dash }}</span>{%- endif -%}
        </td>
    {% endif %}
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'routes_table.access_count'|trans }}">{{ row.accessCount|number_format }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'routes_table.request_time'|trans }}">
        {%- if row.requestTime is not null -%}
            {%- set _rt = row.requestTime -%}
            <span class="{{ nowo_ui_class(_rt > (_t.request_time.critical ?? 1.0) ? 'badge_danger' : (_rt > (_t.request_time.warning ?? 0.5) ? 'badge_warning' : 'badge_success'), _b) }}">{{ (_rt * 1000)|number_format(2) }} ms</span>
        {%- else -%}<span class="{{ _muted }}">{{ _dash }}</span>{%- endif -%}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'routes_table.query_time'|trans }}" data-nowo-ui-priority="2">
        {%- if row.queryTime is not null %}<span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ (row.queryTime * 1000)|number_format(2) }} ms</span>{% else %}<span class="{{ _muted }}">{{ _dash }}</span>{% endif -%}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'routes_table.total_queries'|trans }}">
        {%- if row.totalQueries is not null -%}
            {%- set _q = row.totalQueries -%}
            <span class="{{ nowo_ui_class(_q > (_t.query_count.critical ?? 50) ? 'badge_danger' : (_q > (_t.query_count.warning ?? 20) ? 'badge_warning' : 'badge_success'), _b) }}">{{ _q }}</span>
        {%- else -%}<span class="{{ _muted }}">{{ _dash }}</span>{%- endif -%}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'routes_table.memory_usage'|trans }}" data-nowo-ui-priority="2">
        {%- if row.memoryUsage is not null -%}
            {%- set _mb = row.memoryUsage / 1048576 -%}
            <span class="{{ nowo_ui_class(_mb > (_t.memory_usage.critical ?? 50.0) ? 'badge_danger' : (_mb > (_t.memory_usage.warning ?? 20.0) ? 'badge_warning' : 'badge_neutral'), _b) }}">{{ _mb|number_format(2) }} MB</span>
        {%- else -%}<span class="{{ _muted }}">{{ _dash }}</span>{%- endif -%}
    </td>
    <td class="{{ _cell }}{{ row.lastAccessedAt ? '' : ' ' ~ _muted }}" data-label="{{ 'routes_table.last_accessed_at'|trans }}" data-nowo-ui-priority="3">
        {%- if row.lastAccessedAt %}<time datetime="{{ row.lastAccessedAt|date('c') }}">{{ row.lastAccessedAt|date(dateFormat|default('Y-m-d H:i')) }}</time>{% else %}{{ _dash }}{% endif -%}
    </td>
    {% if page.columns|filter(c => c.key == 'review') is not empty %}
        <td class="{{ _cell }}" data-label="{{ 'routes_table.review_status'|trans }}" data-nowo-ui-priority="2">
            {%- if row.reviewed -%}
                <span class="{{ nowo_ui_class('badge_success', _b) }}">{{ 'routes_table.reviewed'|trans }}</span>
                {%- if row.reviewedAt %} <time class="{{ nowo_ui_class('muted', _b) }}" datetime="{{ row.reviewedAt|date('c') }}">{{ row.reviewedAt|date(dateFormat|default('Y-m-d H:i')) }}</time>{% endif -%}
                {%- if row.queriesImproved is not null %} <span class="{{ nowo_ui_class(row.queriesImproved ? 'badge_success' : 'badge_danger', _b) }}">{{ (row.queriesImproved ? 'routes_table.queries_improved' : 'routes_table.queries_not_improved')|trans }}</span>{% endif -%}
                {%- if row.timeImproved is not null %} <span class="{{ nowo_ui_class(row.timeImproved ? 'badge_success' : 'badge_danger', _b) }}">{{ (row.timeImproved ? 'routes_table.time_improved' : 'routes_table.time_not_improved')|trans }}</span>{% endif -%}
            {%- else -%}
                <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ 'routes_table.not_reviewed'|trans }}</span>
            {%- endif -%}
        </td>
    {% endif %}
{% endblock %}

{% block nowo_ui_list_after %}
    {% set _b = page.bundle %}
    {% set _has_trend = trend is defined and trend.values|default([]) is not empty %}
    {% set _top_used = top_used_routes|default([]) %}
    {% set _top_consumed = top_consumed_routes|default([]) %}
    {% if _has_trend or _top_used is not empty or _top_consumed is not empty %}
        <div class="{{ nowo_ui_class('cards', _b) }}" data-nowo-ui-region="cards">
            {% if _has_trend %}
                {% set _trend_title = 'ui.trend.title'|trans({'%days%': trend.values|length}) %}
                {% set _body %}
                        {{ include('@NowoPerformanceBundle/Performance/_bar_chart.html.twig', {labels: trend.labels, values: trend.values, unit: ' ms', title: _trend_title}) }}
                {% endset %}
                {{ include('@NowoPerformanceBundle/Performance/_card.html.twig', {title: _trend_title, intro: 'ui.trend.intro'|trans, bundle: _b, testid: 'performance-trend', body: _body}) }}
            {% endif %}
            {% if _top_used is not empty %}
                {% set _body %}
                        <ol>
                            {% for _item in _top_used %}
                                <li><code class="{{ nowo_ui_class('code', _b) }}">{{ _item.name }}</code> <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ _item.access_count|number_format }}</span></li>
                            {% endfor %}
                        </ol>
                {% endset %}
                {{ include('@NowoPerformanceBundle/Performance/_card.html.twig', {title: 'statistics.top_used_routes'|trans, bundle: _b, testid: 'performance-top-used', body: _body}) }}
            {% endif %}
            {% if _top_consumed is not empty %}
                {% set _body %}
                        <ol>
                            {% for _item in _top_consumed %}
                                <li><code class="{{ nowo_ui_class('code', _b) }}">{{ _item.name }}</code> <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ (_item.request_time * 1000)|number_format(2) }} ms</span></li>
                            {% endfor %}
                        </ol>
                {% endset %}
                {{ include('@NowoPerformanceBundle/Performance/_card.html.twig', {title: 'statistics.top_consumed_routes'|trans, bundle: _b, testid: 'performance-top-consumed', body: _body}) }}
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% for _id, _form in reviewForms|default({}) %}
        {% set _route = page.rows|filter(r => r.id == _id)|first %}
        {% set _body %}
            {{ form_start(_form, {action: path('nowo_performance.review', {id: _id}), attr: {'data-testid': 'performance-review-form-' ~ _id}}) }}
                <p><code class="{{ nowo_ui_class('code', page.bundle) }}">{{ _route ? _route.name : '#' ~ _id }}</code></p>
                {# REQ-TWIG-003: child loop (fields, CSRF token, submit) #}
                {% for _child in _form %}{% if not _child.rendered %}{{ form_row(_child, 'submit' in _child.vars.block_prefixes ? {attr: _child.vars.attr|merge({class: nowo_ui_class('btn_primary', page.bundle)})} : {}) }}{% endif %}{% endfor %}
            {{ form_end(_form) }}
        {% endset %}
        {{ include(nowo_ui_partial('dialog', page.bundle), {
            id: constant('Nowo\\PerformanceBundle\\Ui\\PerformancePageFactory::REVIEW_DIALOG_PREFIX') ~ _id,
            title: ((_route and _route.reviewed) ? 'review.modal_title_edit' : 'review.modal_title')|trans,
            body: _body,
            bundle: page.bundle,
        }) }}
    {% endfor %}
{% endblock %}
