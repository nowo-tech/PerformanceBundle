{#
  Access records (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  PerformancePageFactory::accessRecords(): header access_statistics.records with the area tabs and the actions Export
  records CSV / JSON, Delete records matching the filter (POST + CSRF FormView behind a Confirm) and Purge records
  (opens the purge dialog) with record management; filters = RecordFiltersType; sortable columns accessed at, route,
  path, status, response time, queries, query time, memory, plus referer and user; rows = list<RouteDataRecord>;
  Pagination; EmptyState access_statistics.no_records).
  Extra variables: purgeForm (PurgeAccessRecordsType, rendered in the purge dialog when record management is on),
  dateTimeFormat, environment; 3.14 variables kept for web_ui.templates overrides: paginated_data, environments,
  available_routes, selected_route, selected_status_code, start_date, end_date, sort_by, order, filterForm,
  deleteByFilterForm (the same FormViews back the page: render each once).
  Data blocks filled: nowo_ui_list_row (cells), nowo_ui_modals (purge dialog).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoPerformanceBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    {% set _muted = nowo_ui_class('table_cell_muted', _b) %}
    {% set _dash = '—' %}
    <td class="{{ _cell }}" data-label="{{ 'access_statistics.timestamp'|trans }}" data-required="1"><time datetime="{{ row.accessedAt|date('c') }}">{{ row.accessedAt|date(dateTimeFormat|default('Y-m-d H:i:s')) }}</time></td>
    <td class="{{ _cell }}" data-label="{{ 'access_statistics.route'|trans }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.routeData ? row.routeData.name : _dash }}</code></td>
    <td class="{{ _cell }}{{ row.routePath ? '' : ' ' ~ _muted }}" data-label="{{ 'access_statistics.path'|trans }}" data-nowo-ui-priority="2">{{ row.routePath ?? _dash }}</td>
    <td class="{{ _cell }}" data-label="{{ 'access_statistics.status_code'|trans }}">
        {%- set _code = row.statusCode -%}
        {%- if _code %}<span class="{{ nowo_ui_class(_code >= 500 ? 'badge_danger' : (_code >= 400 ? 'badge_warning' : (_code >= 300 ? 'badge_info' : 'badge_success')), _b) }}">{{ _code }}</span>{% else %}<span class="{{ _muted }}">{{ _dash }}</span>{% endif -%}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'access_statistics.response_time'|trans }}">{{ row.responseTime is not null ? (row.responseTime * 1000)|number_format(2) ~ ' ms' : _dash }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'access_statistics.total_queries'|trans }}" data-nowo-ui-priority="2">{{ row.totalQueries ?? _dash }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'access_statistics.query_time'|trans }}" data-nowo-ui-priority="3">{{ row.queryTime is not null ? (row.queryTime * 1000)|number_format(2) ~ ' ms' : _dash }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'access_statistics.memory_usage'|trans }}" data-nowo-ui-priority="3">{{ row.memoryUsage is not null ? (row.memoryUsage / 1048576)|number_format(2) ~ ' MB' : _dash }}</td>
    <td class="{{ _cell }}{{ row.referer ? '' : ' ' ~ _muted }}" data-label="{{ 'access_statistics.referer'|trans }}" data-nowo-ui-priority="3">{{ row.referer ?? _dash }}</td>
    <td class="{{ _cell }}{{ row.userIdentifier or row.userId ? '' : ' ' ~ _muted }}" data-label="{{ 'access_statistics.user'|trans }}" data-nowo-ui-priority="3">{{ row.userIdentifier ?? row.userId ?? _dash }}</td>
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% if purgeForm is defined and purgeForm is not null and page.header.actions|filter(a => a.dialogId == constant('Nowo\\PerformanceBundle\\Ui\\PerformancePageFactory::PURGE_DIALOG_ID')) is not empty %}
        {% set _body %}
            <p>{{ 'access_statistics.purge_records_help'|trans }}</p>
            <p><strong>{{ 'access_statistics.purge_records_confirm'|trans }}</strong></p>
            {{ form_start(purgeForm, {action: path('nowo_performance.purge_records'), attr: {'data-testid': 'performance-purge-form'}}) }}
                {# REQ-TWIG-003: child loop (type, days, environment, CSRF token, Purge) #}
                {% for _child in purgeForm %}{% if not _child.rendered %}{{ form_row(_child, 'submit' in _child.vars.block_prefixes ? {attr: _child.vars.attr|merge({class: nowo_ui_class('btn_danger', page.bundle)})} : {}) }}{% endif %}{% endfor %}
            {{ form_end(purgeForm) }}
        {% endset %}
        {{ include(nowo_ui_partial('dialog', page.bundle), {
            id: constant('Nowo\\PerformanceBundle\\Ui\\PerformancePageFactory::PURGE_DIALOG_ID'),
            title: 'access_statistics.purge_records_title'|trans,
            body: _body,
            bundle: page.bundle,
        }) }}
    {% endif %}
{% endblock %}
