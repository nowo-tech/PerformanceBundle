{% extends nowo_performance_layout_template|default('@NowoPerformanceBundle/Performance/layout.html.twig') %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{# When the host sets layout_template to the project layout, stack assets via parent(). #}
{# REQ-UI-001: accept css_framework / ui_template / template; bootstrap5 ≡ bootstrap markup #}
{% set _perf_css = nowo_performance_css_framework|default(css_framework|default(ui_template|default(template|default('bootstrap5')))) %}
{% set _is_bootstrap = _perf_css != 'tailwind' and (ui_template|default(_perf_css)) != 'tailwind' %}
{% set _ui = _is_bootstrap ? 'bootstrap' : 'tailwind' %}
{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}" rel="stylesheet">
    {% endblock %}
    {% block styles %}{% endblock styles %}
    {% block head_extra %}{% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    {% block scripts_extra %}{% endblock %}
{% endblock %}

{# Prefer host `body` (typical Symfony base). Demo layout nests the same blocks. #}
{% block body %}
    {% block nowo_ui_content %}
        {% block nowo_performance_content %}
            {% block flash_messages %}
                {% for message in app.flashes('success') %}
                    <div class="{{ ui.flash('success', _perf_css) }} m-4" role="alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="{{ ui.flash('error', _perf_css) }} m-4" role="alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('warning') %}
                    <div class="{{ ui.flash('warning', _perf_css) }} m-4" role="alert">{{ message }}</div>
                {% endfor %}
            {% endblock %}

            {% if _is_bootstrap %}
                <div class="container-fluid py-4">
                    {{ block('flash_messages') }}
                    {% block content %}{% endblock %}
                </div>
            {% else %}
                <div class="min-h-screen bg-gray-50 py-8">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        {{ block('flash_messages') }}
                        {{ block('content') }}
                    </div>
                </div>
            {% endif %}
        {% endblock %}
    {% endblock %}
{% endblock %}
