{% extends nowo_performance_layout_template|default('@NowoPerformanceBundle/Performance/layout.html.twig') %}

{# When the host sets layout_template to the project layout, stack assets via parent(). #}
{# REQ-UI-001: accept css_framework / ui_template / template; bootstrap5 ≡ bootstrap markup #}
{% set _perf_css = nowo_performance_css_framework|default(css_framework|default(ui_template|default(template|default('bootstrap5')))) %}
{% set _is_bootstrap = _perf_css != 'tailwind' and (ui_template|default(_perf_css)) != 'tailwind' %}
{% set _ui = _is_bootstrap ? 'bootstrap' : 'tailwind' %}
{% block stylesheets %}
    {{ parent() }}
    {% block styles %}{% endblock styles %}
    {% block head_extra %}{% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    {% block scripts_extra %}{% endblock %}
{% endblock %}

{# Prefer host `body` (typical Symfony base). Demo layout nests the same blocks. #}
{% block body %}
    {% block nowo_ui_content %}
        {% block nowo_performance_content %}
            {% block flash_messages %}
                {% if _is_bootstrap %}
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show m-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show m-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-warning alert-dismissible fade show m-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% else %}
                    {% for message in app.flashes('success') %}
                        <div class="mb-4 rounded-md bg-green-50 p-4">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    {{ ux_icon('bi:check-circle', {class: 'h-5 w-5 text-green-400'}) }}
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-green-800">{{ message }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="mb-4 rounded-md bg-red-50 p-4">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    {{ ux_icon('bi:x-circle', {class: 'h-5 w-5 text-red-400'}) }}
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-red-800">{{ message }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('warning') %}
                        <div class="mb-4 rounded-md bg-yellow-50 p-4">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    {{ ux_icon('bi:exclamation-triangle', {class: 'h-5 w-5 text-yellow-400'}) }}
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-yellow-800">{{ message }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            {% endblock %}

            {% if _is_bootstrap %}
                <div class="container-fluid py-4">
                    {{ block('flash_messages') }}
                    {% block content %}{% endblock %}
                </div>
            {% else %}
                <div class="min-h-screen bg-gray-50 py-8">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        {{ block('flash_messages') }}
                        {{ block('content') }}
                    </div>
                </div>
            {% endif %}
        {% endblock %}
    {% endblock %}
{% endblock %}
