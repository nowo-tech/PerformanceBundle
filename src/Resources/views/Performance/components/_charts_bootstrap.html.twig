<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Performance Trends</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_start(chartFiltersForm) }}
                        {{ form_label(chartFiltersForm.metric, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(chartFiltersForm.metric, {attr: {class: 'form-select form-select-sm', style: 'width: auto; display: inline-block;'}}) }}
                        {{ form_label(chartFiltersForm.days, null, {label_attr: {class: 'form-label ms-3'}}) }}
                        {{ form_widget(chartFiltersForm.days, {attr: {class: 'form-select form-select-sm', style: 'width: auto; display: inline-block;'}}) }}
                        {% for child in chartFiltersForm %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                    {{ form_end(chartFiltersForm) }}
                </div>
                <canvas id="performanceChart" style="max-height: 400px;"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof Chart === 'undefined') return;

    const env = '{{ environment }}';
    const routeName = '{{ currentRoute ?? '' }}';
    let chart = null;

    function loadChartData(metric, days) {
        const url = new URL('{{ path('nowo_performance.api.chart_data') }}', window.location.origin);
        url.searchParams.set('env', env);
        url.searchParams.set('metric', metric);
        url.searchParams.set('days', days);
        if (routeName) {
            url.searchParams.set('route', routeName);
        }

        fetch(url)
            .then(response => response.json())
            .then(data => {
                if (chart) {
                    chart.destroy();
                }

                const canvas = document.getElementById('performanceChart');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                chart = new Chart(ctx, {
                    type: 'line',
                    data: data,
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            })
            .catch(error => {
                console.error('Error loading chart data:', error);
            });
    }

    // Initial load
    loadChartData('requestTime', 7);

    // Update on change
    const chartMetric = document.getElementById('chart-metric');
    const chartDays = document.getElementById('chart-days');
    if (chartMetric) {
        chartMetric.addEventListener('change', function() {
            loadChartData(this.value, document.getElementById('chart-days')?.value || '7');
        });
    }
    if (chartDays) {
        chartDays.addEventListener('change', function() {
            loadChartData(document.getElementById('chart-metric')?.value || 'requestTime', this.value);
        });
    }
});
</script>
