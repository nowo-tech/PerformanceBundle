{#
  Diagnose (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from PerformancePageFactory::diagnose():
  header ui.diagnose.title with the area tabs; one detail section per diagnostic group — configuration, environment,
  database connection, table status, data status, route tracking, subscriber status; the terms are the diagnostic
  keys).
  Extra variable: diagnostic (the raw array, also kept for web_ui.templates overrides): issues, warnings and
  suggestions are printed above the sections.
  Data block filled: nowo_ui_show_sections (findings, then the default sections).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoPerformanceBundle' %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    {% set _findings = [
        {key: 'issues', slot: 'flash_error'},
        {key: 'warnings', slot: 'flash_warning'},
        {key: 'suggestions', slot: 'flash_info'},
    ] %}
    {% set _any = false %}
    {% for _f in _findings %}
        {% set _list = diagnostic[_f.key] ?? [] %}
        {% if _list is not empty %}
            {% set _any = true %}
            <div class="{{ nowo_ui_class('flash', _b) }} {{ nowo_ui_class(_f.slot, _b) }}" role="{{ _f.key == 'issues' ? 'alert' : 'status' }}" data-testid="performance-diagnose-{{ _f.key }}">
                <p><strong>{{ ('ui.diagnose.' ~ _f.key)|trans({'%count%': _list|length}) }}</strong></p>
                <ul>
                    {% for _message in _list %}<li>{{ _message }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endfor %}
    {% if not _any %}
        <div class="{{ nowo_ui_class('flash', _b) }} {{ nowo_ui_class('flash_success', _b) }}" role="status" data-testid="performance-diagnose-ok">{{ 'ui.diagnose.all_good'|trans }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}
