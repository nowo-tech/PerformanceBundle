{#
  Advanced statistics (REQ-UI-003): UiKit dashboard scaffold. Variable: page (View\DashboardPage from
  PerformancePageFactory::statistics(): header statistics_page.title with the area tabs; KPI tiles total routes,
  median request time (p95), mean queries (p95), routes needing attention).
  Extra variables: envForm (StatisticsEnvFilterType, GET, auto-submit), advanced_stats (metric => detailed
  statistics), routes_needing_attention, recommendations, correlations, efficiency, traffic_distribution, environment,
  environments, total_routes.
  Data block filled: nowo_ui_dashboard_cards (environment, recommendations, correlations, efficiency, traffic, routes
  needing attention, one card per metric with its histogram).
#}
{% extends '@NowoUiKit/page/dashboard.html.twig' %}
{% trans_default_domain 'NowoPerformanceBundle' %}

{% block nowo_ui_dashboard_cards %}
    {% set _b = page.bundle %}
    {% set _card = '@NowoPerformanceBundle/Performance/_card.html.twig' %}

    {% set _body %}
            {{ form_start(envForm, {attr: {class: nowo_ui_class('filters', _b), role: 'search'}}) }}
                {% for _child in envForm %}{% if not _child.rendered %}{{ form_row(_child, {attr: _child.vars.attr|merge({'data-nowo-ui-autosubmit': ''})}) }}{% endif %}{% endfor %}
                <div class="{{ nowo_ui_class('filters_actions', _b) }}"><button type="submit" class="{{ nowo_ui_class('btn_secondary', _b) }}">{{ 'filters.apply_filters'|trans }}</button></div>
            {{ form_end(envForm) }}
    {% endset %}
    {{ include(_card, {title: 'filters.environment'|trans, bundle: _b, testid: 'performance-statistics-env', body: _body}) }}

    {% if recommendations|default([]) is not empty %}
        {% set _body %}
                <ul>
                    {% for _r in recommendations %}
                        <li>
                            <span class="{{ nowo_ui_class(_r.priority == 'high' ? 'badge_danger' : (_r.priority == 'medium' ? 'badge_warning' : 'badge_info'), _b) }}">{{ ('ui.statistics.priority.' ~ (_r.priority in ['high', 'medium'] ? _r.priority : 'low'))|trans }}</span>
                            <strong>{{ _r.title }}</strong> — {{ _r.description }}
                            {% if _r.action|default(null) %}<br><span class="{{ nowo_ui_class('muted', _b) }}">{{ 'ui.statistics.recommendation_action'|trans }} {{ _r.action }}</span>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
        {% endset %}
        {{ include(_card, {title: 'ui.statistics.recommendations'|trans, bundle: _b, testid: 'performance-recommendations', body: _body}) }}
    {% endif %}

    {% if correlations|default([]) is not empty %}
        {% set _items = [] %}
        {% for _entry in ['request_time_vs_query_time', 'request_time_vs_query_count', 'query_time_vs_query_count', 'memory_vs_request_time'] %}
            {% set _c = correlations[_entry] ?? null %}
            {% if _c %}
                {% set _coef = _c.coefficient|default(0) %}
                {% set _items = _items|merge([{label: ('ui.statistics.correlation.' ~ _entry)|trans ~ ' (' ~ 'ui.statistics.sample_size'|trans({'%count%': _c.sample_size|default(0)}) ~ ')', value: _coef ~ (_c.interpretation|default('') ? ' · ' ~ _c.interpretation : ''), badge: _coef|abs >= 0.7 ? 'danger' : (_coef|abs >= 0.5 ? 'warning' : 'neutral'), href: null}]) %}
            {% endif %}
        {% endfor %}
        {% set _body %}{{ include(nowo_ui_partial('detail_list', _b), {items: _items, bundle: _b}) }}{% endset %}
        {{ include(_card, {title: 'ui.statistics.correlations'|trans, intro: 'ui.statistics.correlations_intro'|trans, bundle: _b, testid: 'performance-correlations', body: _body}) }}
    {% endif %}

    {% if efficiency|default([]) is not empty %}
        {% set _body %}
                {% if efficiency.avg_query_ratio is defined and efficiency.avg_query_ratio is not null %}
                    <p>{{ 'ui.statistics.avg_query_ratio'|trans({'%ratio%': efficiency.avg_query_ratio}) }}</p>
                {% endif %}
                {% for _group in [{key: 'query_bottleneck_routes', title: 'ui.statistics.query_bottlenecks', intro: 'ui.statistics.query_bottlenecks_intro'}, {key: 'inefficient_routes', title: 'ui.statistics.inefficient_routes', intro: 'ui.statistics.inefficient_routes_intro'}] %}
                    {% set _list = efficiency[_group.key] ?? [] %}
                    {% if _list is not empty %}
                        <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ _group.title|trans }}</h3>
                        <p class="{{ nowo_ui_class('muted', _b) }}">{{ _group.intro|trans }}</p>
                        <ul>
                            {% for _item in _list|slice(0, 5) %}
                                <li><code class="{{ nowo_ui_class('code', _b) }}">{{ _item.route.name }}</code> — {{ (_item.request_time * 1000)|number_format(2) }} ms · {{ 'ui.statistics.queries'|trans({'%count%': _item.query_count ?? '—'}) }}{% if _item.query_ratio is defined %} · {{ 'ui.statistics.query_ratio'|trans({'%ratio%': _item.query_ratio}) }}{% endif %}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endfor %}
        {% endset %}
        {{ include(_card, {title: 'ui.statistics.efficiency'|trans, bundle: _b, testid: 'performance-efficiency', body: _body}) }}
    {% endif %}

    {% if traffic_distribution|default([]) is not empty %}
        {% set _body %}
                {% if traffic_distribution.traffic_concentration is defined and traffic_distribution.traffic_concentration is not null %}
                    <p>{{ 'ui.statistics.traffic_concentration'|trans({'%ratio%': traffic_distribution.traffic_concentration}) }}</p>
                {% endif %}
                <p>{{ 'access_statistics.total_accesses'|trans }}: <strong>{{ traffic_distribution.total_accesses|default(0)|number_format }}</strong></p>
                {% if traffic_distribution.hot_paths|default([]) is not empty %}
                    <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'ui.statistics.hot_paths'|trans }}</h3>
                    <ol>
                        {% for _item in traffic_distribution.hot_paths|slice(0, 10) %}
                            <li><code class="{{ nowo_ui_class('code', _b) }}">{{ _item.route.name }}</code> <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ _item.access_count|number_format }}</span> <span class="{{ nowo_ui_class('badge_info', _b) }}">{{ _item.percentage }}%</span></li>
                        {% endfor %}
                    </ol>
                {% endif %}
        {% endset %}
        {{ include(_card, {title: 'ui.statistics.traffic'|trans, bundle: _b, testid: 'performance-traffic', body: _body}) }}
    {% endif %}

    {% set _body %}
            {% for _group in [{key: 'slow_request_time', title: 'ui.statistics.slow_request_time', unit: 'ms'}, {key: 'high_query_count', title: 'ui.statistics.high_query_count', unit: ''}, {key: 'high_memory', title: 'ui.statistics.high_memory', unit: 'MB'}] %}
                {% set _list = routes_needing_attention[_group.key] ?? [] %}
                <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ _group.title|trans }}</h3>
                {% if _list is not empty %}
                    <ul>
                        {% for _item in _list|slice(0, 10) %}
                            <li><code class="{{ nowo_ui_class('code', _b) }}">{{ _item.route.name }}</code> <span class="{{ nowo_ui_class('badge_danger', _b) }}">{{ _group.unit == 'ms' ? (_item.value * 1000)|number_format(2) ~ ' ms' : (_group.unit == 'MB' ? _item.value|number_format(2) ~ ' MB' : _item.value) }}</span></li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'ui.statistics.no_routes'|trans }}</p>
                {% endif %}
            {% endfor %}
    {% endset %}
    {{ include(_card, {title: 'statistics_page.routes_needing_attention'|trans, intro: 'statistics_page.routes_above_p95'|trans, bundle: _b, testid: 'performance-attention', body: _body}) }}

    {% for _metric, _s in advanced_stats|default({}) %}
        {% if _s.count|default(0) > 0 %}
            {% set _metric_label = ('statistics_page.' ~ _metric)|trans %}
                    {% set _unit = _s.unit ? ' ' ~ _s.unit : '' %}
                    {% set _items = [] %}
                    {% for _k, _entry in {mean: 'statistics_page.mean', median: 'statistics_page.median', mode: 'statistics_page.mode', std_dev: 'statistics_page.std_deviation', min: 'statistics_page.min', max: 'statistics_page.max', range: 'statistics_page.range'} %}
                        {% set _items = _items|merge([{label: _entry|trans, value: _s[_k] ~ _unit, badge: null, href: null}]) %}
                    {% endfor %}
                    {% for _p, _v in _s.percentiles|default({}) %}
                        {% set _items = _items|merge([{label: ('statistics_page.p' ~ _p)|trans, value: _v ~ _unit, badge: null, href: null}]) %}
                    {% endfor %}
                    {% set _items = _items|merge([{label: 'statistics_page.outliers'|trans, value: _s.outliers_count, badge: _s.outliers_count > 0 ? 'warning' : 'success', href: null}]) %}
            {% set _body %}
                    {{ include(nowo_ui_partial('detail_list', _b), {items: _items, bundle: _b}) }}
                    {% if _s.distribution|default([]) is not empty %}
                        <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'statistics_page.histogram'|trans }}</h3>
                        {{ include('@NowoPerformanceBundle/Performance/_bar_chart.html.twig', {labels: _s.bucket_labels, values: _s.distribution, decimals: 0, unit: '', title: 'statistics_page.histogram'|trans ~ ' — ' ~ _metric_label}) }}
                    {% endif %}
            {% endset %}
            {{ include(_card, {title: 'ui.statistics.metric_title'|trans({'%metric%': _metric_label}), intro: 'ui.statistics.samples'|trans({'%count%': _s.count}), bundle: _b, testid: 'performance-metric-' ~ _metric|replace({_: '-'}), body: _body}) }}
        {% endif %}
    {% endfor %}
{% endblock %}
