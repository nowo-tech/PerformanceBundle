{% extends 'base.html.twig' %}

{% block title %}Home - Performance Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('nowo_performance.index') }}" class="nowo-ui-btn nowo-ui-btn--outline">View performance metrics</a>
        <a href="{{ path('product_index') }}" class="nowo-ui-btn nowo-ui-btn--primary">View products (tracked)</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Performance Bundle Demo',
        intro: 'This demo shows how the Performance Bundle tracks route performance metrics.',
        toolbar: _toolbar|trim,
    }) }}
{% endblock %}

{% block content %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Quick links', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a class="nowo-ui-link" href="{{ path('product_index') }}">Products CRUD</a></li>
                <li><a class="nowo-ui-link" href="{{ path('nowo_performance.index') }}">Performance dashboard</a></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Performance metrics (' ~ env ~ ')', kind: 'content', empty: routes|length == 0, state_message: 'No routes tracked yet. Visit some routes to see metrics!'} %}
        {% block section_body %}
            <p>Total routes tracked: {{ routes|length }}</p>
        {% endblock %}
    {% endembed %}

    {% if worstRoutes|length > 0 %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Worst performing routes', kind: 'table'} %}
            {% block section_body %}
                <table class="nowo-ui-data-table">
                    <thead>
                        <tr>
                            <th>Route</th>
                            <th class="nowo-ui-cell--num">Request time</th>
                            <th class="nowo-ui-cell--num">Queries</th>
                            <th class="nowo-ui-cell--num">Query time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for route in worstRoutes %}
                            <tr>
                                <td>{{ route.name }}</td>
                                <td class="nowo-ui-cell--num">{{ route.requestTime ? route.requestTime|number_format(4) ~ 's' : 'N/A' }}</td>
                                <td class="nowo-ui-cell--num">{{ route.totalQueries ?? 'N/A' }}</td>
                                <td class="nowo-ui-cell--num">{{ route.queryTime ? route.queryTime|number_format(4) ~ 's' : 'N/A' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
