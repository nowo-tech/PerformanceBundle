{% extends 'base.html.twig' %}

{% block title %}Product #{{ product.id }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('product_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to list</a>
        <a href="{{ path('product_edit', {'id': product.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Product #' ~ product.id, toolbar: _toolbar|trim}) }}
{% endblock %}

{% block content %}
    {% set _badge = product.status == 'active' ? 'success' : (product.status == 'inactive' ? 'danger' : 'warning') %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ product.id }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Name</dt><dd class="nowo-ui-detail-list__value">{{ product.name }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Description</dt><dd class="nowo-ui-detail-list__value">{{ product.description ?? 'N/A' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Price</dt><dd class="nowo-ui-detail-list__value">${{ product.price }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Image URL</dt><dd class="nowo-ui-detail-list__value">{{ product.imageUrl ?? 'N/A' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Status</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--{{ _badge }}">{{ product.status }}</span></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Created at</dt><dd class="nowo-ui-detail-list__value">{% if product.createdAt %}<time datetime="{{ product.createdAt|date('c') }}">{{ product.createdAt|date('Y-m-d H:i:s') }}</time>{% else %}N/A{% endif %}</dd></div>
            </dl>
        {% endblock %}
    {% endembed %}
{% endblock %}
