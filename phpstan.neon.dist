# PHPStan configuration for Performance Bundle
# Compatible with PHP 8.2+ and Symfony 7.x / 8.x

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - demo/*
        - tests/stub_ux_icon.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
